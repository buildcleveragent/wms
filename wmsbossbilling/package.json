{
  "name": "wms-boss-billing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:h5": "CI=1 UNI_INPUT_DIR=$PWD uni -p h5 --host 127.0.0.1 --port 5176",
    "build:h5": "CI=1 UNI_INPUT_DIR=$PWD uni build -p h5",
    "build:mp-weixin": "CI=1 UNI_INPUT_DIR=$PWD uni build -p mp-weixin",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:quality": "npm run test:unit && npm run build:h5 && npm run test:e2e",
    "test:release": "npm run test:quality && npm run build:mp-weixin"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-h5": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260626810",
    "pinia": "2.3.1",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260626810",
    "@playwright/test": "1.61.1",
    "@vue/compiler-sfc": "3.5.39",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "sass": "1.77.8",
    "vite": "8.1.0",
    "vitest": "3.2.4"
  },
  "overrides": {
    "@intlify/core-base": "9.14.5",
    "@intlify/message-compiler": "9.14.5",
    "@intlify/message-resolver": "9.14.5",
    "@intlify/runtime": "9.14.5",
    "@intlify/vue-devtools": "9.14.5",
    "adm-zip": "0.6.0",
    "jpeg-js": "0.4.4",
    "postcss": "8.5.23",
    "ws": "8.21.0"
  }
}
