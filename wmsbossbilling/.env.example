# H5 production can stay empty when the web server forwards same-origin /api requests.
VITE_API_BASE_URL=
VITE_ALLOW_PRIVATE_API=false
# Temporary HTTP builds require an explicit opt-in.
VITE_ALLOW_HTTP_API=false
# HBuilder/Vite H5 development only: forward browser /api requests to Django.
WMS_DEV_API_TARGET=http://127.0.0.1:8000
