APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ENABLE_DEBUG_TOOLBAR=True
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.6
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,http://192.168.1.33:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://192.168.1.33:5173
# Production values must contain HTTPS origins only. Enable this only when the
# reverse proxy overwrites X-Forwarded-Proto and strips untrusted client values.
TRUST_PROXY_SSL_HEADER=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
DB_NAME=wms_db
DB_ENGINE=django.db.backends.mysql
DB_TEST_NAME=
DB_USER=wmsuser
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# JSON：微信支付平台公钥序列号映射到 PEM 文本或 PEM 文件路径。
WECHAT_PAY_PLATFORM_KEYS={}
WECHAT_PAY_VERIFY_CALLBACK_SIGNATURE=False
WECHAT_PAY_CALLBACK_MAX_AGE_SECONDS=300
SALE_MINI_PAY_TIMEOUT_MINUTES=30
SALE_MINI_REFUND_MAX_RETRIES=6
SALE_MINI_REFUND_QUERY_INTERVAL_MINUTES=5
SALE_MINI_PAY_TIMEOUT_MINUTES=30
SALE_MINI_POINT_EXCHANGE_RATE=100
SALE_MINI_DISTRIBUTION_COMMISSION_RATE=0
LOG_LEVEL=INFO
OUTBOUND_LEGACY_AUTHZ_MODE=enforce
WMS_ACCESS_SCOPE_LEGACY_FALLBACK=False
# 登录接口双层限流；代理层数为 0 时忽略客户端提供的 X-Forwarded-For。
LOGIN_USERNAME_IP_RATE=5/min
LOGIN_IP_RATE=30/min
LOGIN_TRUSTED_PROXY_COUNT=0
# Replenishment rollout switches (enable in the documented rollout order)
REPLENISHMENT_MANUAL_ENABLED=False
REPLENISHMENT_PDA_ENABLED=False
REPLENISHMENT_MINMAX_ENABLED=False
REPLENISHMENT_DEMAND_ENABLED=False
RELOCATION_REQUEST_ENABLED=False
RELOCATION_PDA_ENABLED=False
RELOCATION_CONTAINER_ENABLED=False
# Enable only after inventory_rebuild_fifo_layers reconciles the whole scope.
INVENTORY_FIFO_ENABLED=False
