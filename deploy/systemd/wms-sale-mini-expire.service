[Unit]
Description=WMS sale-mini expired payment reconciliation
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=wms
Group=wms
WorkingDirectory=/wms
EnvironmentFile=-/etc/default/wms
ExecStart=/usr/bin/flock -n /run/lock/wms-sale-mini-payments.lock /usr/bin/docker compose -f /wms/compose.production.yml --profile oneshot run --rm sale-mini-expire
