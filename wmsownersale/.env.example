# H5 本地开发留空，浏览器通过前端 /api/ 代理访问 Django。
# App、微信小程序及独立部署时，设置实际的 HTTPS API 地址。
VITE_API_BASE_URL=
VITE_ALLOW_PRIVATE_API=false
VITE_ALLOW_HTTP_API=false
# Android 使用 config/android/.env.production，不读取本目录 H5 的地址。

# 仅用于 Vite 开发服务器，不写入客户端构建产物。
# 若 HBuilderX 和 Django 不在同一台机器，请改为 Django 的局域网地址。
WMS_DEV_API_TARGET=http://127.0.0.1:8001
