<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.jinqiaorongtong.wmsownersale">
    <!-- Keep features out of distribute.android.permissions: the cloud packager
         generates camera features there for Barcode, causing duplicate nodes.
         Override them in the main manifest so camera hardware stays optional. -->
    <uses-feature android:name="android.hardware.camera"
        android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.camera.autofocus"
        android:required="false" tools:node="replace" />
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
